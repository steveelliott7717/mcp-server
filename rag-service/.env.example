# Supabase PostgREST (data-plane only — no direct DB connection, no DDL capability).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_API_KEY=<service_role-or-anon-key>

# Model providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Models (override as needed; defaults are current IDs)
EMBEDDING_MODEL=text-embedding-3-large
GENERATION_MODEL=claude-sonnet-5
GRADING_MODEL=claude-haiku-4-5-20251001

# Retrieval defaults
DEFAULT_SCHEMA=professional_profile
DEFAULT_TABLE=work_experience_chunks

# Bearer token the MCP server presents. Leave blank to disable auth (local dev only).
TRUST_TOKEN=
